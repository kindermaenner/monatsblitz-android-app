@startuml
skinparam componentStyle uml2

package "de.kindermaenner.monatsblitz.ui" {
    component "Screens (Compose)" as Screens
    component "ViewModels" as ViewModels
}

package "de.kindermaenner.monatsblitz.domain" {
    component "Use Cases" as UseCases
    component "Models" as Models
    interface "Repository Interfaces" as IRepo
}

package "de.kindermaenner.monatsblitz.infrastructure" {
    component "Repository Implementations" as RepoImpl
    component "Retrofit API" as API
    component "Room DAO" as DAO
    component "DataStore / Preferences" as Storage
}

ViewModels ..> UseCases : nutzt
ViewModels ..> IRepo : nutzt
UseCases ..> IRepo : nutzt
RepoImpl ..|> IRepo : realisiert
RepoImpl ..> API : nutzt
RepoImpl ..> DAO : nutzt
RepoImpl ..> Storage : nutzt

@enduml
